From 6fc11985815a93b7d010fcc3adc215ef836dcddb Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 10 Jun 2026 09:54:46 +0000
Subject: [PATCH 2/9] fix(security): seed admin from env vars and refuse
 default JWT secret in production

- Remove hardcoded admin email/password from main.py; require ADMIN_EMAIL /
  ADMIN_PASSWORD env vars to seed (otherwise silently skip).
- Refuse to boot in production when JWT_SECRET is the placeholder; generate
  a per-process random secret in dev so local flow keeps working.
- Drop unused api_football_* settings.
- Update .env.example accordingly.
---
 .env.example          | 21 ++++++++++++++++-----
 backend/app/config.py | 31 +++++++++++++++++++++++++++----
 backend/app/main.py   | 23 ++++++++++++++---------
 3 files changed, 57 insertions(+), 18 deletions(-)

diff --git a/.env.example b/.env.example
index 2de985f..9c6cfb4 100644
--- a/.env.example
+++ b/.env.example
@@ -1,10 +1,21 @@
-# API-Football
-API_FOOTBALL_KEY=your_key_here
-API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
+# --- Data provider ---------------------------------------------------------
+# Free key from https://www.football-data.org/client/register (TIER_ONE)
+FOOTBALL_DATA_KEY=your_key_here
+FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
 
-# PostgreSQL
+# --- Database --------------------------------------------------------------
 DATABASE_URL=postgresql://user:password@host:port/dbname
 
-# App
+# --- App -------------------------------------------------------------------
 APP_ENV=development
 CORS_ORIGINS=http://localhost:5173
+
+# --- Auth ------------------------------------------------------------------
+# REQUIRED in production. Use `python -c "import secrets; print(secrets.token_urlsafe(48))"`
+JWT_SECRET=change-me-in-production-use-long-random-string
+JWT_EXPIRE_MINUTES=10080
+
+# Initial admin seeded on first boot (no-op if user already exists).
+# Leave empty to skip seeding entirely.
+ADMIN_EMAIL=
+ADMIN_PASSWORD=
diff --git a/backend/app/config.py b/backend/app/config.py
index a47a1be..ac938ed 100644
--- a/backend/app/config.py
+++ b/backend/app/config.py
@@ -1,26 +1,49 @@
+import logging
+import secrets
+
 from pydantic_settings import BaseSettings
 
+logger = logging.getLogger(__name__)
+
+_DEFAULT_JWT_SECRET = "change-me-in-production-use-long-random-string"
+
 
 class Settings(BaseSettings):
-    # Legacy provider (kept optional for fallback / reference)
-    api_football_key: str = ""
-    api_football_base_url: str = "https://v3.football.api-sports.io"
     # Primary data provider: football-data.org (free tier covers current season)
     football_data_key: str = ""
     football_data_base_url: str = "https://api.football-data.org/v4"
     database_url: str
     app_env: str = "development"
     cors_origins: str = "http://localhost:5173"
-    jwt_secret: str = "change-me-in-production-use-long-random-string"
+    jwt_secret: str = _DEFAULT_JWT_SECRET
     jwt_algorithm: str = "HS256"
     jwt_expire_minutes: int = 60 * 24 * 7  # 7 days
 
+    # Admin seeded on first boot. MUST be provided via env in production.
+    admin_email: str = ""
+    admin_password: str = ""
+
     @property
     def cors_origins_list(self) -> list[str]:
         return [o.strip() for o in self.cors_origins.split(",")]
 
+    @property
+    def is_production(self) -> bool:
+        return self.app_env.lower() in {"production", "prod"}
+
     class Config:
         env_file = ".env"
 
 
 settings = Settings()
+
+# Hard-fail in production if defaults leaked through. Dev gets a warning + a
+# random secret so tokens still work locally.
+if settings.jwt_secret == _DEFAULT_JWT_SECRET:
+    if settings.is_production:
+        raise RuntimeError(
+            "JWT_SECRET must be set to a strong random value in production. "
+            "Refusing to start with the default."
+        )
+    settings.jwt_secret = secrets.token_urlsafe(48)
+    logger.warning("JWT_SECRET not set — generated a random per-process secret (dev only).")
diff --git a/backend/app/main.py b/backend/app/main.py
index 27be262..b718acf 100644
--- a/backend/app/main.py
+++ b/backend/app/main.py
@@ -12,16 +12,21 @@ from app.services.scheduler import setup_scheduler
 
 
 def _seed_admin(db) -> None:
+    """Seed the admin user from ADMIN_EMAIL / ADMIN_PASSWORD env vars.
+    Silently skipped if either is missing — no implicit/hardcoded fallback."""
     from app.models.user import User
-    existing = db.query(User).filter(User.email == "orismar.bm@gmail.com").first()
-    if not existing:
-        admin = User(
-            email="orismar.bm@gmail.com",
-            hashed_password=hash_password("amor1234"),
-            is_active=True,
-        )
-        db.add(admin)
-        db.commit()
+
+    email = (settings.admin_email or "").strip().lower()
+    password = settings.admin_password or ""
+    if not email or not password:
+        return
+
+    existing = db.query(User).filter(User.email == email).first()
+    if existing:
+        return
+
+    db.add(User(email=email, hashed_password=hash_password(password), is_active=True))
+    db.commit()
 
 
 @asynccontextmanager
